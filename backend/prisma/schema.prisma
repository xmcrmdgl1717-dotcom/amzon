generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
  SUPER_ADMIN
  OPERATOR
  SUPPORT
}

enum OrderStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  SHIPPED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String   @default("Admin")
  role         Role     @default(OPERATOR)
  orders       Order[]  @relation("Reviewer")
  logs         AuditLog[]
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  targetId  String?
  details   String?
  createdAt DateTime @default(now())
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  products Product[]
}

model Product {
  id           String               @id @default(uuid())
  slug         String               @unique
  basePrice    Float
  image        String
  stock        Int                  @default(100)
  rating       Float                @default(4.5)
  reviewCount  Int                  @default(120)
  isPrime      Boolean              @default(true)
  categoryId   String?
  category     Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  
  translations ProductTranslation[]
  orderItems   OrderItem[]
  reviews      Review[] // 👈 关联评论
}

model ProductTranslation {
  productId   String
  locale      String
  title       String
  description String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@id([productId, locale])
}

model Order {
  id            String      @id @default(uuid())
  orderNumber   String      @unique
  status        OrderStatus @default(PENDING_REVIEW)
  customerName  String
  customerEmail String
  shippingAddr  String
  customerId    String?
  locale        String      @default("en")
  totalAmount   Float
  rejectReason  String?
  reviewedById  String?
  reviewedBy    User?       @relation("Reviewer", fields: [reviewedById], references: [id])
  items         OrderItem[]
  createdAt     DateTime    @default(now())
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float
}

model Customer {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  reviews      Review[] // 👈 关联评论
}

model Banner {
  id        String   @id @default(uuid())
  imageUrl  String
  linkUrl   String?
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// 👈 新增：评论模型
model Review {
  id         String   @id @default(uuid())
  rating     Int      // 1-5 星
  content    String
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

// ... (前面的 generator, datasource, 枚举等保持不变)

// 👈 新增：优惠券模型
model Coupon {
  id          String   @id @default(uuid())
  code        String   @unique // 优惠码，例如 "SUMMER20"
  discount    Float    // 折扣比例 (例如 0.1 代表 10%) 或者固定金额
  isPercentage Boolean @default(true) // 是否按百分比打折
  minPurchase Float    @default(0) // 最低消费门槛
  isActive    Boolean  @default(true)
  expiresAt   DateTime? // 过期时间 (可选)
  createdAt   DateTime @default(now())
}

model Order {
  id            String      @id @default(uuid())
  orderNumber   String      @unique
  status        OrderStatus @default(PENDING_REVIEW)
  customerName  String
  customerEmail String
  shippingAddr  String
  customerId    String?
  locale        String      @default("en")
  totalAmount   Float
  // 👈 新增优惠券字段
  couponCode    String?
  discountAmount Float      @default(0)
  
  rejectReason  String?
  reviewedById  String?
  reviewedBy    User?       @relation("Reviewer", fields: [reviewedById], references: [id])
  items         OrderItem[]
  createdAt     DateTime    @default(now())
}

// ... (其他模型 Category, Product, Customer, Banner, Review 等保持不变)

